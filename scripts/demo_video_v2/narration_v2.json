[
 {
  "scene": 1,
  "line": 1,
  "start": 0.6,
  "end": 4.74,
  "text": "공문, 쪽지, 그리고 업무관리시스템 배부까지."
 },
 {
  "scene": 1,
  "line": 2,
  "start": 4.74,
  "end": 9.18,
  "text": "들어오는 모든 업무를 캘린더 하나로 모읍니다."
 },
 {
  "scene": 2,
  "line": 1,
  "start": 9.18,
  "end": 12.67,
  "text": "하루에도 수십 건씩 오는 문서와 쪽지."
 },
 {
  "scene": 2,
  "line": 2,
  "start": 12.67,
  "end": 17.83,
  "text": "그 속에 묻힌 업무 하나를 한 달 반 뒤에야 발견한 적이 있습니다."
 },
 {
  "scene": 2,
  "line": 3,
  "start": 17.83,
  "end": 23.46,
  "text": "그래서 내부망에서 쓰는 업무 누락 방지 도구를 만들었습니다."
 },
 {
  "scene": 3,
  "line": 1,
  "start": 23.46,
  "end": 32.19,
  "text": "업무는 세 갈래로 들어옵니다. 감시 폴더의 공문 파일, 메신저 쪽지, 업무관리시스템의 배부 문서입니다."
 },
 {
  "scene": 3,
  "line": 2,
  "start": 32.19,
  "end": 36.94,
  "text": "들어온 업무는 업무인지 먼저 판단한 뒤 캘린더에 오릅니다."
 },
 {
  "scene": 3,
  "line": 3,
  "start": 36.94,
  "end": 43.56,
  "text": "모든 과정은 내 PC 안에서만 이루어지고, 외부와 통신하지 않습니다."
 },
 {
  "scene": 4,
  "line": 1,
  "start": 43.56,
  "end": 46.87,
  "text": "아침에 켜면 출근 브리핑이 먼저 뜹니다."
 },
 {
  "scene": 4,
  "line": 2,
  "start": 46.87,
  "end": 52.46,
  "text": "기한이 지난 업무와 오늘 마감, 이번 주 마감을 한눈에 보여 줍니다."
 },
 {
  "scene": 4,
  "line": 3,
  "start": 52.46,
  "end": 58.1,
  "text": "메인 화면은 월간 캘린더이고, 라벨 색으로 출처와 종류를 나눕니다."
 },
 {
  "scene": 4,
  "line": 4,
  "start": 58.1,
  "end": 66.14,
  "text": "감시 폴더에 공문 PDF가 저장되면 제목과 기한, 문서번호를 찾아 바로 등록합니다."
 },
 {
  "scene": 5,
  "line": 1,
  "start": 66.14,
  "end": 69.2,
  "text": "메신저 쪽지는 창을 열기만 하면,"
 },
 {
  "scene": 5,
  "line": 2,
  "start": 69.2,
  "end": 72.27,
  "text": "기한과 함께 캘린더에 올라갑니다."
 },
 {
  "scene": 5,
  "line": 3,
  "start": 72.27,
  "end": 75.35,
  "text": "하지만 쪽지가 모두 업무는 아닙니다."
 },
 {
  "scene": 5,
  "line": 4,
  "start": 75.35,
  "end": 84.96,
  "text": "단순 인사와 시스템 알림은 스스로 걸러내고, 기한이 애매한 쪽지만 확인 필요로 분리해 오등록 없이 정확하게 관리합니다."
 },
 {
  "scene": 5,
  "line": 5,
  "start": 84.96,
  "end": 91.07,
  "text": "애매한 쪽지는 확인 필요에 모아 두고, 캘린더와 알림에는 띄우지 않습니다."
 },
 {
  "scene": 5,
  "line": 6,
  "start": 91.07,
  "end": 97.94,
  "text": "걸러 낸 쪽지는 제외된 쪽지에서 다시 보고, 필요하면 업무로 등록합니다."
 },
 {
  "scene": 6,
  "line": 1,
  "start": 97.94,
  "end": 102.03,
  "text": "업무관리시스템의 배부 문서도 자동으로 등록합니다."
 },
 {
  "scene": 6,
  "line": 2,
  "start": 102.03,
  "end": 107.07,
  "text": "부서장이 문서를 나에게 배부하면 결재시행 목록에 나타납니다."
 },
 {
  "scene": 6,
  "line": 3,
  "start": 107.07,
  "end": 111.45,
  "text": "목록을 열어 두기만 하면 3초 뒤 업무로 등록됩니다."
 },
 {
  "scene": 6,
  "line": 4,
  "start": 111.45,
  "end": 116.21,
  "text": "목록에는 처리기한이 없어, 기한은 일단 추정으로 둡니다."
 },
 {
  "scene": 6,
  "line": 5,
  "start": 116.21,
  "end": 120.91,
  "text": "문서를 열면 본문의 회신기한을 읽어 기한을 확정합니다."
 },
 {
  "scene": 6,
  "line": 6,
  "start": 120.91,
  "end": 126.26,
  "text": "업무관리자로 받은 문서는 확인 필요로 보내, 직접 고르게 합니다."
 },
 {
  "scene": 6,
  "line": 7,
  "start": 126.26,
  "end": 132.35,
  "text": "목록과 문서는 읽기만 하고, 문서를 열거나 결재하지 않습니다."
 },
 {
  "scene": 7,
  "line": 1,
  "start": 132.35,
  "end": 136.58,
  "text": "같은 일을 동료 쪽지로 먼저 받았다면 어떻게 될까요?"
 },
 {
  "scene": 7,
  "line": 2,
  "start": 136.58,
  "end": 142.15,
  "text": "새로 만들지 않고, 먼저 있던 업무에 배부 출처를 붙여 하나로 합칩니다."
 },
 {
  "scene": 7,
  "line": 3,
  "start": 142.15,
  "end": 148.27,
  "text": "출처에는 쪽지와 업무관리시스템 문서번호가 함께 남습니다."
 },
 {
  "scene": 8,
  "line": 1,
  "start": 148.27,
  "end": 152.48,
  "text": "매주 반복하는 업무는 주황색 정기 라벨로 표시되고,"
 },
 {
  "scene": 8,
  "line": 2,
  "start": 152.48,
  "end": 159.94,
  "text": "앞으로의 날짜가 캘린더에 미리 보여, 다음 일정까지 한눈에 계획할 수 있습니다."
 },
 {
  "scene": 9,
  "line": 1,
  "start": 159.94,
  "end": 164.22,
  "text": "한 줄로 쓰면 기한과 시각을 읽어 바로 등록하고,"
 },
 {
  "scene": 9,
  "line": 2,
  "start": 164.22,
  "end": 167.02,
  "text": "끌어다 놓으면 기한이 바뀝니다."
 },
 {
  "scene": 9,
  "line": 3,
  "start": 167.02,
  "end": 170.22,
  "text": "여러 업무를 골라 한 번에 지울 수 있고,"
 },
 {
  "scene": 9,
  "line": 4,
  "start": 170.22,
  "end": 173.38,
  "text": "F1 키로 단축키 안내를 엽니다."
 },
 {
  "scene": 9,
  "line": 5,
  "start": 173.38,
  "end": 179.35,
  "text": "창 크기에 맞춰, 캘린더가 보여 줄 업무 수를 스스로 맞춥니다."
 },
 {
  "scene": 10,
  "line": 1,
  "start": 179.35,
  "end": 184.49,
  "text": "외부 통신 없이, 표준 라이브러리만으로, 설치 없이 실행됩니다."
 },
 {
  "scene": 10,
  "line": 2,
  "start": 184.49,
  "end": 187.48,
  "text": "받은 업무, 이제 놓치지 않습니다."
 }
]